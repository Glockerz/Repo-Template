// native_api/registry.def — the single registration table.
//
// Row format (parsed by tools/verify.mjs and included by registry.cpp):
//
//     FN(c_symbol, "lua.name", translation_unit, Cap::Capability)
//
// `c_symbol` must have an implementation named `l_<c_symbol>` in the named
// translation unit, with the signature `int l_<c_symbol>(lua_State*)`.
//
// Rules that keep this file honest:
//   * a row here is a promise that the function exists and is probe-gated;
//   * the lua name must appear in docs/UNC_COVERAGE.md (verify.mjs check 1);
//   * the capability must be declared in api.h (verify.mjs check 2), and the
//     function is only registered when that capability passed its canary.

// ---- environment -------------------------------------------------------------
FN(getgenv,            "getgenv",            env,       Cap::Env)
FN(getrenv,            "getrenv",            env,       Cap::Env)
FN(getreg,             "getreg",             env,       Cap::Gc)
FN(getsenv,            "getsenv",            env,       Cap::Env)
FN(gettenv,            "gettenv",            env,       Cap::Env)
FN(getfenv_native,     "getfenv",            env,       Cap::Env)
FN(setfenv_native,     "setfenv",            env,       Cap::Env)
FN(getgc,              "getgc",              env,       Cap::Gc)
FN(shadow_print,       "print",              env,       Cap::Env)
FN(shadow_warn,        "warn",               env,       Cap::Env)
FN(shadow_error,       "error",              env,       Cap::Env)

